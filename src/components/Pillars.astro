---
import { copy } from '../i18n/copy';
import type { Lang } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const items = copy[lang].pillars;
const icons = [
  '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>',
  '<path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
  '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 14h8M8 18h5"/>',
];
---

<section class="pillars" aria-label={items.map((i) => i.title).join(', ')}>
  <ul role="list" class="wrap pillars__list">
    {
      items.map((p, i) => (
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[i]} />
          <h3 class="display">{p.title}</h3>
          <p>{p.text}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .pillars {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem);
    background: linear-gradient(180deg, var(--night), #081a2e);
    border-block: 1px solid rgb(147 164 184 / 0.1);
  }

  .pillars__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
  }

  li {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  svg {
    width: 2.2rem;
    height: 2.2rem;
    color: var(--arc);
    filter: drop-shadow(0 0 8px rgb(63 224 255 / 0.5));
  }

  h3 {
    margin-top: 0.5rem;
    font-size: var(--step-2);
    color: #fff;
  }

  p {
    color: var(--steel);
    max-width: 34ch;
  }

  @media (max-width: 760px) {
    .pillars__list {
      grid-template-columns: 1fr;
    }

    li {
      grid-template-columns: auto 1fr;
      column-gap: 1rem;
    }

    svg {
      grid-row: span 2;
    }

    h3 {
      margin-top: 0;
    }
  }
</style>
