---
import Icon from './Icon.astro';
import Status from './Status.astro';
import { copy } from '../i18n/copy';
import { site, type Lang } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang].hero;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <picture class="hero__media">
    <source
      media="(max-width: 700px), (orientation: portrait) and (max-width: 1100px)"
      srcset={`${base}/hero/panel-v-600.webp 600w, ${base}/hero/panel-v-940.webp 940w`}
      sizes="100vw"
      width="940"
      height="1672"
    />
    <img
      src={`${base}/hero/panel-1672.webp`}
      srcset={`${base}/hero/panel-1100.webp 1100w, ${base}/hero/panel-1672.webp 1672w`}
      sizes="100vw"
      alt={t.photo}
      width="1672"
      height="940"
      fetchpriority="high"
      decoding="async"
      data-hero-img
    />
  </picture>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="wrap hero__content">
    <Status lang={lang} class="hero__status" />
    <h1 class="display hero__title" id="hero-title">
      <span class="chrome">{t.titleA}</span>
      <span class="chrome">{t.titleB}</span>
    </h1>
    <p class="lead hero__lead">{t.lead}</p>
    <div class="hero__ctas">
      <a class="btn btn--charge" href={site.phone.href} data-magnet>
        <Icon name="phone" />
        {t.call} {site.phone.display}
      </a>
      <a class="btn btn--line" href="#estimate">{t.estimate}</a>
    </div>
    <p class="hero__exp">
      <span class="hero__exp-mark" aria-hidden="true">10+</span>
      <span>{t.experience}</span>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-block: 7rem 4rem;
    overflow: hidden;
    background: var(--night);
  }

  .hero__media,
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 40%;
  }

  /* Darken the left side for the copy, and fade the bottom into the page */
  .hero__shade {
    background:
      linear-gradient(90deg, var(--night) 0%, rgb(6 17 31 / 0.88) 28%, rgb(6 17 31 / 0.35) 52%, transparent 70%),
      linear-gradient(0deg, var(--night) 0%, transparent 22%),
      linear-gradient(180deg, rgb(6 17 31 / 0.6) 0%, transparent 18%);
  }

  .hero__content {
    position: relative;
  }

  .hero__status {
    margin-bottom: 1.5rem;
  }

  .hero__title {
    display: grid;
    font-size: clamp(3.4rem, 1.4rem + 8vw, 8.6rem);
    text-transform: uppercase;
    line-height: 0.86;
    filter: drop-shadow(0 4px 0 rgb(3 9 17 / 0.65));
  }

  .hero__title span {
    display: block;
    padding-bottom: 0.04em;
  }

  .hero__lead {
    margin-top: 1.75rem;
    color: #b4c3d3;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero__exp {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 2.75rem;
    max-width: 30rem;
    color: var(--steel);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .hero__exp-mark {
    flex: none;
    font-size: 2.6rem;
    font-weight: 800;
    font-stretch: 62%;
    line-height: 1;
    color: var(--arc);
    text-shadow: 0 0 18px rgb(63 224 255 / 0.55);
  }

  /* Page-load sequence: the room's lights flicker on, then the type powers up */
  :global(.js) .hero__media img {
    filter: brightness(0.12) saturate(0.5);
  }

  :global(.hero.is-live) .hero__media img {
    animation: lights-on 1.3s steps(1, end) both;
  }

  @keyframes lights-on {
    0% {
      filter: brightness(0.12) saturate(0.5);
    }
    12% {
      filter: brightness(0.9) saturate(1);
    }
    18% {
      filter: brightness(0.2) saturate(0.6);
    }
    30% {
      filter: brightness(1.15) saturate(1.1);
    }
    36% {
      filter: brightness(0.45) saturate(0.8);
    }
    48%,
    100% {
      filter: none;
    }
  }

  :global(.js) .hero__title span,
  :global(.js) .hero__lead,
  :global(.js) .hero__ctas,
  :global(.js) .hero__exp,
  :global(.js) .hero__status {
    opacity: 0;
  }

  :global(.hero.is-live) .hero__title span {
    animation: power-up 1s var(--ease-out) both;
    animation-delay: 0.45s;
  }

  :global(.hero.is-live) .hero__title span + span {
    animation-delay: 0.53s;
  }

  :global(.hero.is-live) .hero__status,
  :global(.hero.is-live) .hero__lead,
  :global(.hero.is-live) .hero__ctas,
  :global(.hero.is-live) .hero__exp {
    animation: rise 0.8s var(--ease-out) both;
    animation-delay: 0.75s;
  }

  :global(.hero.is-live) .hero__ctas {
    animation-delay: 0.85s;
  }

  :global(.hero.is-live) .hero__exp {
    animation-delay: 1s;
  }

  @keyframes power-up {
    0% {
      opacity: 0;
      font-stretch: 50%;
      letter-spacing: 0.08em;
      filter: brightness(3) drop-shadow(0 0 18px var(--arc));
    }
    20% {
      opacity: 1;
    }
    35% {
      opacity: 0.4;
    }
    50% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      font-stretch: 62%;
      letter-spacing: 0;
      filter: none;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 700px), (orientation: portrait) and (max-width: 1100px) {
    .hero {
      align-items: end;
      padding-block: 52svh 2.5rem;
    }

    /* The portrait photo keeps the electrician up top and fades to dark below */
    .hero__media img {
      object-position: 50% 0;
    }

    .hero__shade {
      background:
        linear-gradient(180deg, rgb(6 17 31 / 0.5) 0%, transparent 14%, transparent 40%, rgb(6 17 31 / 0.75) 56%, var(--night) 72%);
    }

    .hero__ctas .btn {
      flex: 1 1 14rem;
    }
  }

  @media (min-width: 701px) and (max-width: 1000px) and (orientation: landscape) {
    .hero__shade {
      background:
        linear-gradient(90deg, var(--night) 0%, rgb(6 17 31 / 0.85) 45%, rgb(6 17 31 / 0.3) 80%),
        linear-gradient(0deg, var(--night) 0%, transparent 22%);
    }
  }

  @media (max-width: 380px) {
    .hero__ctas .btn {
      white-space: normal;
      text-align: center;
    }
  }

  @media (min-width: 701px) and (max-height: 720px) {
    .hero__title {
      font-size: clamp(3.4rem, 13vh, 7rem);
    }
  }
</style>
