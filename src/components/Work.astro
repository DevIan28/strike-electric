---
import Icon from './Icon.astro';
import { copy } from '../i18n/copy';
import { site, type Lang, type WorkCategory } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const w = t.work;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const FEATURED = 12;
const filters = [
  { key: 'all', label: w.all, count: site.work.length },
  ...(Object.keys(w.cats) as WorkCategory[]).map((key) => ({
    key,
    label: w.cats[key],
    count: site.work.filter((p) => p.cat === key).length,
  })),
];
---

{
  site.work.length > 0 && (
    <section class="section work" id="work" aria-labelledby="work-title" data-work>
      <div class="wrap">
        <div class="work__head">
          <div>
            <h2 class="display h2" id="work-title">{w.title}</h2>
            <p class="lead">{w.lead}</p>
          </div>
          <div class="filters" role="group" aria-label={w.filter}>
            {filters.map((f, i) => (
              <button type="button" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
                {f.label}
                <span class="filters__n">{f.count}</span>
              </button>
            ))}
          </div>
        </div>

        <ul role="list" class="grid">
          {site.work.map((p, i) => (
            <li data-cat={p.cat} data-extra={i >= FEATURED ? '' : undefined} hidden={i >= FEATURED}>
              <button type="button" class="tile" data-index={i} aria-label={`${w.open}: ${p.alt[lang]}`}>
                <img
                  src={`${base}/work/${p.id}-sm.webp`}
                  alt={p.alt[lang]}
                  width={p.w}
                  height={p.h}
                  loading="lazy"
                  decoding="async"
                />
                <span class="tile__cap" aria-hidden="true">{p.alt[lang]}</span>
              </button>
            </li>
          ))}
        </ul>

        {site.work.length > FEATURED && (
          <div class="work__more">
            <button type="button" class="btn btn--line" data-more>
              {w.more} ({site.work.length})
            </button>
          </div>
        )}
      </div>

      <dialog class="viewer" data-viewer aria-label={w.title}>
        <figure>
          <img data-viewer-img alt="" />
          <figcaption>
            <span data-viewer-cap />
            <span class="viewer__count" data-viewer-count />
          </figcaption>
        </figure>
        <button type="button" class="viewer__btn viewer__close" data-viewer-close>
          <Icon name="close" />
          <span class="sr-only">{w.close}</span>
        </button>
        <button type="button" class="viewer__btn viewer__prev" data-viewer-prev>
          <Icon name="up" />
          <span class="sr-only">{w.prev}</span>
        </button>
        <button type="button" class="viewer__btn viewer__next" data-viewer-next>
          <Icon name="up" />
          <span class="sr-only">{w.next}</span>
        </button>
      </dialog>

      <script
        type="application/json"
        data-work-data
        set:html={JSON.stringify({
          of: w.of,
          items: site.work.map((p) => ({ src: `${base}/work/${p.id}.webp`, alt: p.alt[lang], cat: p.cat })),
        })}
      />
    </section>
  )
}

<style>
  .work__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .work__head .lead {
    margin-top: 1rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    min-width: 0;
  }

  .filters button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border: 0;
    border-radius: 999px;
    background: #040b15;
    box-shadow: 0 0 0 1px rgb(147 164 184 / 0.18) inset;
    white-space: nowrap;
    color: var(--steel);
    font-weight: 650;
    font-stretch: 90%;
    cursor: pointer;
    transition:
      color 0.25s,
      background-color 0.25s,
      box-shadow 0.25s;
  }

  .filters button:hover {
    color: var(--chrome);
  }

  .filters__n {
    font-size: 0.8rem;
    color: rgb(147 164 184 / 0.7);
    font-variant-numeric: tabular-nums;
  }

  .filters button[aria-pressed='true'] .filters__n {
    color: var(--arc);
  }

  .work__more {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .work__more[hidden] {
    display: none;
  }

  .filters button[aria-pressed='true'] {
    color: #fff;
    background: linear-gradient(180deg, #2a4c70, #163453);
    box-shadow:
      0 0 0 1px rgb(63 224 255 / 0.5) inset,
      0 0 18px -4px rgb(63 224 255 / 0.6);
  }

  /* Masonry by columns keeps every photo at its own proportions */
  .grid {
    columns: 3 17rem;
    column-gap: 0.85rem;
  }

  .grid li {
    break-inside: avoid;
    margin-bottom: 0.85rem;
  }

  .grid li[hidden] {
    display: none;
  }

  .tile {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--navy);
    cursor: zoom-in;
  }

  .tile img {
    width: 100%;
    height: auto;
    transition:
      transform 0.6s var(--ease-out),
      filter 0.4s;
  }

  .tile__cap {
    position: absolute;
    inset: auto 0 0;
    padding: 2.5rem 1rem 0.9rem;
    background: linear-gradient(transparent, rgb(3 9 17 / 0.88));
    color: var(--chrome);
    font-size: 0.92rem;
    line-height: 1.35;
    text-align: left;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.3s,
      transform 0.3s var(--ease-out);
  }

  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 0 0 1px rgb(147 164 184 / 0.12) inset;
    transition: box-shadow 0.3s;
    pointer-events: none;
  }

  .tile:hover img,
  .tile:focus-visible img {
    transform: scale(1.04);
  }

  .tile:hover .tile__cap,
  .tile:focus-visible .tile__cap {
    opacity: 1;
    transform: none;
  }

  .tile:hover::after,
  .tile:focus-visible::after {
    box-shadow:
      0 0 0 2px var(--arc) inset,
      0 0 30px -6px rgb(63 224 255 / 0.7) inset;
  }

  @media (max-width: 600px) {
    .grid {
      columns: 2;
      column-gap: 0.6rem;
    }

    .grid li {
      margin-bottom: 0.6rem;
    }

    /* One swipeable row of chips on phones */
    .filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .filters::-webkit-scrollbar {
      display: none;
    }
  }

  /* Viewer */
  .viewer {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(3 9 17 / 0.96);
    color: var(--chrome);
  }

  .viewer::backdrop {
    background: rgb(3 9 17 / 0.8);
  }

  .viewer[open] {
    display: grid;
    place-items: center;
  }

  .viewer figure {
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    padding: 4.5rem 1rem 1.5rem;
  }

  .viewer img {
    max-width: min(92vw, 70rem);
    max-height: calc(100dvh - 9rem);
    width: auto;
    height: auto;
    border-radius: var(--radius-m);
    box-shadow: 0 30px 80px -20px #000;
  }

  .viewer[open] img {
    animation: pop 0.35s var(--ease-out);
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }

  .viewer figcaption {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    color: var(--chrome);
    font-size: 0.95rem;
    text-align: center;
  }

  .viewer__count {
    color: var(--steel);
    font-variant-numeric: tabular-nums;
  }

  .viewer__btn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    color: #fff;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .viewer__btn:hover {
    background: rgb(63 224 255 / 0.25);
  }

  .viewer__btn :global(svg) {
    width: 1.35rem;
    height: 1.35rem;
  }

  .viewer__close {
    top: 1rem;
    right: 1rem;
  }

  .viewer__prev,
  .viewer__next {
    top: 50%;
    translate: 0 -50%;
  }

  .viewer__prev {
    left: 1rem;
  }

  .viewer__prev :global(svg) {
    rotate: -90deg;
  }

  .viewer__next {
    right: 1rem;
  }

  .viewer__next :global(svg) {
    rotate: 90deg;
  }

  @media (max-width: 700px) {
    .viewer__prev,
    .viewer__next {
      top: auto;
      bottom: calc(1rem + env(safe-area-inset-bottom));
      translate: none;
    }
  }
</style>
