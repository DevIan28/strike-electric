---
import Icon from './Icon.astro';
import { copy } from '../i18n/copy';
import { site, type Lang } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="wrap about__grid">
    <div class="about__story">
      <h2 class="display h2" id="about-title">{t.about.title}</h2>
      {t.about.body.map((p) => <p>{p}</p>)}
    </div>

    <aside class="area" aria-labelledby="area-title">
      <h3 id="area-title">
        <Icon name="pin" />
        {t.about.areaTitle}
      </h3>
      <ul role="list">
        {site.areas.map((a) => <li>{a}</li>)}
      </ul>
      <p>
        {t.about.areaNote}
        <a href={site.phone.href}>{site.phone.display}</a>
      </p>
    </aside>
  </div>

</section>

<style>
  .about {
    background:
      radial-gradient(50rem 30rem at 100% 0%, rgb(19 48 79 / 0.6), transparent 70%),
      var(--night);
  }

  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .about__story p {
    margin-top: 1.25rem;
    max-width: 60ch;
    color: var(--steel);
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .about__story p:first-of-type {
    margin-top: 2rem;
    color: var(--chrome);
  }

  .area {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-l);
    background: rgb(11 32 56 / 0.7);
    box-shadow: 0 0 0 1px rgb(147 164 184 / 0.14) inset;
  }

  .area h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step-1);
    font-weight: 700;
    font-stretch: 80%;
  }

  .area h3 :global(svg) {
    width: 1.4rem;
    color: var(--arc);
  }

  .area ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .area li {
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    background: rgb(3 9 17 / 0.6);
    box-shadow: 0 0 0 1px rgb(63 224 255 / 0.25) inset;
    font-size: 0.95rem;
  }

  .area p {
    margin-top: 1.5rem;
    color: var(--steel);
  }

  .area a {
    color: var(--arc);
    text-decoration: none;
    font-weight: 600;
    margin-left: 0.25rem;
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
