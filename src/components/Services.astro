---
import { copy } from '../i18n/copy';
import type { Lang } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang].services;
const groups = [
  { key: 'residential', label: t.tabs.residential, items: t.residential },
  { key: 'commercial', label: t.tabs.commercial, items: t.commercial },
] as const;
---

<section class="section services" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <div class="services__head">
      <div>
        <h2 class="display h2" id="services-title">{t.title}</h2>
        <p class="lead">{t.lead}</p>
      </div>

      <div class="rocker" role="tablist" aria-label={t.title} data-rocker>
        <span class="rocker__thumb" aria-hidden="true"></span>
        {
          groups.map((g, i) => (
            <button
              role="tab"
              type="button"
              id={`tab-${g.key}`}
              aria-controls={`panel-${g.key}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {g.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="board">
      <span class="board__screw" aria-hidden="true"></span>
      <span class="board__screw" aria-hidden="true"></span>
      <span class="board__screw" aria-hidden="true"></span>
      <span class="board__screw" aria-hidden="true"></span>
      {
        groups.map((g, i) => (
          <div
            class="board__panel"
            role="tabpanel"
            id={`panel-${g.key}`}
            aria-labelledby={`tab-${g.key}`}
            hidden={i !== 0}
            data-board
          >
            <span class="bus" aria-hidden="true" />
            <ul role="list" class="circuits">
              {g.items.map((s) => (
                <li class="circuit">
                  <span class="breaker" aria-hidden="true" style="--on: 1">
                    <span class="breaker__handle" />
                  </span>
                  <div>
                    <h3>{s.name}</h3>
                    <p>{s.text}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .services__head .lead {
    margin-top: 1rem;
  }

  /* Rocker switch tabs */
  .rocker {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 0.35rem;
    border-radius: 999px;
    background: #040b15;
    box-shadow:
      0 0 0 1px rgb(147 164 184 / 0.18) inset,
      0 2px 8px rgb(0 0 0 / 0.6) inset;
  }

  .rocker__thumb {
    position: absolute;
    top: 0.35rem;
    bottom: 0.35rem;
    left: 0.35rem;
    width: calc(50% - 0.35rem);
    border-radius: 999px;
    background: linear-gradient(180deg, #2a4c70, #163453);
    box-shadow:
      0 0 0 1px rgb(63 224 255 / 0.5) inset,
      0 0 22px -4px rgb(63 224 255 / 0.6);
    transition: transform 0.5s var(--ease-snap);
  }

  :global(.rocker[data-index='1']) .rocker__thumb {
    transform: translateX(100%);
  }

  .rocker button {
    position: relative;
    min-width: 8.5rem;
    min-height: 3rem;
    padding: 0 1.4rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--steel);
    font-weight: 650;
    font-stretch: 90%;
    cursor: pointer;
    transition: color 0.3s;
  }

  .rocker button[aria-selected='true'] {
    color: #fff;
  }

  /* The board: a panel door with four screws */
  .board {
    position: relative;
    padding: clamp(1.25rem, 3vw, 2.75rem);
    border-radius: var(--radius-l);
    background: linear-gradient(165deg, #15365a 0%, var(--navy) 45%, #08182b 100%);
    box-shadow:
      0 0 0 1px rgb(147 164 184 / 0.16) inset,
      0 1px 0 rgb(255 255 255 / 0.08) inset,
      0 40px 80px -40px rgb(0 0 0 / 0.9);
  }

  .board__screw {
    position: absolute;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background:
      linear-gradient(45deg, transparent 44%, #1a2d42 44% 56%, transparent 56%),
      radial-gradient(circle at 35% 35%, #8ea2b8, #3b506a);
  }

  .board__screw:nth-child(1) {
    top: 0.9rem;
    left: 0.9rem;
  }

  .board__screw:nth-child(2) {
    top: 0.9rem;
    right: 0.9rem;
  }

  .board__screw:nth-child(3) {
    bottom: 0.9rem;
    left: 0.9rem;
  }

  .board__screw:nth-child(4) {
    bottom: 0.9rem;
    right: 0.9rem;
  }

  .board__panel {
    position: relative;
  }

  /* Copper bus bar down the middle */
  .bus {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 0.55rem;
    transform: translateX(-50%);
    border-radius: 0.3rem;
    background: linear-gradient(90deg, #8a4a20, #e9a06a 45%, #b8652e 70%, #7a3f19);
    box-shadow: 0 0 18px -4px rgb(208 122 60 / 0.6);
  }

  .circuits {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 4.5rem;
    row-gap: 0.75rem;
  }

  .circuit {
    position: relative;
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    padding: 1.25rem 1.25rem;
    border-radius: var(--radius-m);
    background: rgb(3 9 17 / 0.5);
    box-shadow: 0 0 0 1px rgb(147 164 184 / 0.1) inset;
    transition:
      background-color 0.3s,
      box-shadow 0.3s;
  }

  /* Copper stub from each circuit to the bus */
  .circuit::after {
    content: '';
    position: absolute;
    top: 2.35rem;
    width: 2.25rem;
    height: 3px;
    background: linear-gradient(90deg, #b8652e, #e9a06a);
  }

  .circuit:nth-child(odd)::after {
    left: 100%;
  }

  .circuit:nth-child(even)::after {
    right: 100%;
  }

  .circuit:hover {
    background: rgb(19 48 79 / 0.55);
    box-shadow: 0 0 0 1px rgb(63 224 255 / 0.35) inset;
  }

  .circuit .breaker {
    margin-top: 0.15rem;
  }

  .circuit h3 {
    font-size: var(--step-1);
    font-weight: 700;
    font-stretch: 78%;
    line-height: 1.15;
    color: #fff;
  }

  .circuit p {
    margin-top: 0.35rem;
    color: var(--steel);
    font-size: 0.98rem;
    line-height: 1.55;
    max-width: 44ch;
  }

  @media (max-width: 820px) {
    .rocker {
      width: 100%;
    }

    .rocker button {
      min-width: 0;
    }

    .bus {
      left: 0.3rem;
      transform: none;
    }

    .circuits {
      grid-template-columns: 1fr;
      padding-left: 1.6rem;
    }

    .circuit::after,
    .circuit:nth-child(odd)::after {
      left: auto;
      right: 100%;
      width: 1.3rem;
    }

    .circuit {
      padding: 1rem;
      gap: 0.9rem;
    }
  }
</style>
