---
import Icon from './Icon.astro';
import { copy } from '../i18n/copy';
import type { Lang } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const icons = [
  '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>',
  '<path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
  '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 14h8M8 18h5"/>',
];
---

<section class="why" data-why aria-labelledby="why-title">
  <canvas class="why__arc" data-arc aria-hidden="true"></canvas>
  <div class="why__flash" aria-hidden="true"></div>

  <div class="wrap why__grid">
    <div class="why__emblem" data-emblem>
      <img src={`${base}/brand/emblem.webp`} alt="" width="460" height="458" loading="lazy" decoding="async" />
      <p class="why__hint" aria-hidden="true">
        <Icon name="bolt" />
        <span class="hint--fine">{t.why.hint}</span>
        <span class="hint--touch">{t.why.hintTouch}</span>
      </p>
    </div>

    <div class="why__copy">
      <h2 class="display h2" id="why-title">{t.why.title}</h2>
      <ul role="list" class="why__list">
        {
          t.pillars.map((p, i) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[i]} />
              <div>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .why {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(4.5rem, 3rem + 6vw, 8rem);
    background:
      radial-gradient(42rem 30rem at 22% 50%, rgb(19 48 79 / 0.95), transparent 70%),
      linear-gradient(180deg, var(--night), #081a2e);
    border-block: 1px solid rgb(147 164 184 / 0.1);
  }

  /* Faint conduit grid around the emblem */
  .why::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(rgb(147 164 184 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(147 164 184 / 0.06) 1px, transparent 1px);
    background-size: 4.5rem 4.5rem;
    mask-image: radial-gradient(ellipse 50% 70% at 25% 50%, #000 20%, transparent 75%);
  }

  .why__arc {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .why__flash {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: radial-gradient(circle at var(--fx, 30%) var(--fy, 30%), rgb(220 250 255 / 0.8), rgb(63 224 255 / 0.2) 35%, transparent 70%);
    opacity: 0;
  }

  :global(.why.is-flash) .why__flash {
    animation: flash 0.7s ease-out;
  }

  @keyframes flash {
    0% {
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    18% {
      opacity: 0.2;
    }
    26% {
      opacity: 0.7;
    }
    100% {
      opacity: 0;
    }
  }

  .why__grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .why__emblem {
    --charge: 0;
    position: relative;
    justify-self: center;
    width: min(100%, 26rem);
    text-align: center;
  }

  .why__emblem::before {
    content: '';
    position: absolute;
    inset: 8% 12% 18%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(63 224 255 / 0.35), transparent 65%);
    opacity: calc(0.45 + var(--charge) * 0.55);
    transform: scale(calc(1 + var(--charge) * 0.25));
  }

  .why__emblem img {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 0 calc(8px + var(--charge) * 40px) rgb(63 224 255 / calc(0.25 + var(--charge) * 0.6)))
      brightness(calc(1 + var(--charge) * 0.35));
    animation: float 7s ease-in-out infinite;
  }

  @keyframes float {
    50% {
      transform: translateY(-10px);
    }
  }

  .why__hint {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.25rem;
    font-size: var(--step--1);
    color: rgb(147 164 184 / 0.75);
  }

  .why__hint :global(svg) {
    color: var(--arc);
  }

  .hint--touch {
    display: none;
  }

  @media (hover: none) {
    .hint--fine {
      display: none;
    }

    .hint--touch {
      display: inline;
    }
  }

  .why__list {
    display: grid;
    gap: 2rem;
    margin-top: 2.5rem;
  }

  .why__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.1rem;
    align-items: start;
  }

  .why__list svg {
    width: 2.2rem;
    height: 2.2rem;
    color: var(--arc);
    filter: drop-shadow(0 0 8px rgb(63 224 255 / 0.5));
  }

  .why__list h3 {
    font-size: var(--step-2);
    font-weight: 800;
    font-stretch: 62%;
    line-height: 1;
    color: #fff;
  }

  .why__list p {
    margin-top: 0.45rem;
    max-width: 40ch;
    color: var(--steel);
  }

  @media (max-width: 820px) {
    .why__grid {
      grid-template-columns: 1fr;
    }

    .why__emblem {
      width: min(64vw, 17rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .why__emblem img {
      animation: none;
    }
  }
</style>
