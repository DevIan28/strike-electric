---
import '@fontsource-variable/saira/standard.css';
import '../styles/global.css';
import { copy } from '../i18n/copy';
import { site, type Lang } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(lang === 'es' ? '/es/' : '/', site.url).href;
const alternate = new URL(lang === 'es' ? '/' : '/es/', site.url).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Electrician',
  name: site.legalName,
  url: site.url,
  telephone: '+1-646-363-1492',
  email: site.email,
  image: `${site.url}/brand/emblem.png`,
  areaServed: site.areas.map((name) => ({ '@type': 'City', name: `${name}, New York` })),
  openingHoursSpecification: Object.entries(site.hours).map(([day, [open, close]]) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'][Number(day)],
    opens: `${String(open).padStart(2, '0')}:00`,
    closes: `${String(close).padStart(2, '0')}:00`,
  })),
};
---

<!doctype html>
<html lang={lang} translate="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="google" content="notranslate" />
    <meta name="theme-color" content="#06111f" />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={lang === 'es' ? 'en' : 'es'} href={alternate} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${base}/icon-192.png`} type="image/png" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <link rel="preload" as="image" type="image/webp" media="(max-width: 700px), (orientation: portrait) and (max-width: 1100px)" href={`${base}/hero/panel-m.webp`} />
    <link
      rel="preload"
      as="image"
      type="image/webp"
      media="(min-width: 701px) and (orientation: landscape), (min-width: 1101px)"
      imagesrcset={`${base}/hero/panel-1100.webp 1100w, ${base}/hero/panel-1672.webp 1672w`}
      imagesizes="100vw"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/og.png`} />
    <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Never leave the hero hidden if the intro script fails to run
      setTimeout(function () {
        var h = document.querySelector('.hero');
        if (h) h.classList.add('is-live');
      }, 2500);
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <slot />
  </body>
</html>
